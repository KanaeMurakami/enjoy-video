リリース <%= Date.today %>
<% ignored_logins = %w[copilot github-copilot] -%>
<% pull_requests.each do |pr| -%>
<%
  base = pr.to_checklist_item
  base_without_mention = base.gsub(/\s*@[-A-Za-z0-9]+\b/i, '').strip

  candidate_logins = []
  candidate_logins.concat(Array(pr.assignees).filter_map { |assignee| assignee.respond_to?(:login) ? assignee.login : nil }) if pr.respond_to?(:assignees)
  candidate_logins << (pr.assignee&.login if pr.respond_to?(:assignee))
  candidate_logins << (pr.user&.login if pr.respond_to?(:user))

  mention_login = candidate_logins.compact.uniq.find do |login|
    !ignored_logins.include?(login.downcase)
  end

  checklist_line = mention_login ? "#{base_without_mention} @#{mention_login}" : base_without_mention
-%><%= checklist_line %>
<% end -%>
